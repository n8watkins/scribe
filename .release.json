{
  "versionFiles": [
    "app/src-tauri/tauri.conf.json",
    "app/src-tauri/Cargo.toml",
    "crates/scribe-core/Cargo.toml",
    {
      "path": "Cargo.lock",
      "pattern": "^name = \"app\"\\r?\\nversion = \"([^\"]+)\""
    },
    {
      "path": "Cargo.lock",
      "pattern": "^name = \"scribe-core\"\\r?\\nversion = \"([^\"]+)\""
    },
    "app/package.json",
    "app/package-lock.json"
  ],
  "workflows": "package",
  "repository": "n8watkins/scribe",
  "visibility": "public"
}
